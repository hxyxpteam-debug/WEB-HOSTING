PORT=3000
NODE_ENV=production
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
# Generate with: node -e "console.log(require('bcryptjs').hashSync('your-long-password',12))"
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash
DATA_DIR=/data
MAX_UPLOAD_MB=10
RAILWAY_API_TOKEN=
RAILWAY_PROJECT_ID=
